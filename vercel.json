{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/it{/}?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/it/products{/}?",
      "destination": "/prodotti/",
      "permanent": true
    },
    {
      "source": "/it/news{/}?",
      "destination": "/notizie/",
      "permanent": true
    },
    {
      "source": "/it/news/:slug{/}?",
      "destination": "/notizie/:slug/",
      "permanent": true
    },
    {
      "source": "/it/contact{/}?",
      "destination": "/contatti/",
      "permanent": true
    },
    {
      "source": "/fr/products{/}?",
      "destination": "/fr/produits/",
      "permanent": true
    },
    {
      "source": "/fr/news{/}?",
      "destination": "/fr/actualites/",
      "permanent": true
    },
    {
      "source": "/fr/news/:slug{/}?",
      "destination": "/fr/actualites/:slug/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.sanity.io https://images.unsplash.com; media-src 'self' https:; font-src 'self'; connect-src 'self'; frame-src https://maps.google.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
