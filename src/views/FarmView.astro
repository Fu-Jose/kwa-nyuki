---
// Placeholder until the client decides the content (probably a photo gallery). noindex keeps
// the empty page out of Google: remove it once the page has content.
import Layout from "../layouts/Layout.astro";
import type { Lang } from "../i18n/ui";
import { pageAlternates, useTranslations } from "../i18n/utils";
import { getSiteSettings } from "../lib/sanity.ts";
import { getPageTitle } from "../lib/contact.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const settings = await getSiteSettings();
---

<Layout
  lang={lang}
  title={getPageTitle(settings, "farm", lang)}
  settings={settings}
  alternates={pageAlternates("farm")}
  noindex
>
  <section class="mx-auto max-w-6xl px-5 pb-24 pt-32 md:px-8">
    <h1 class="font-serif text-5xl md:text-6xl">{t.nav.farm}</h1>
  </section>
</Layout>
