---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import HowToBuy from "../components/HowToBuy.astro";
import type { Lang } from "../i18n/ui";
import { pageAlternates, useTranslations } from "../i18n/utils";
import { getProducts, getSiteSettings } from "../lib/sanity.ts";
import { getPageTitle } from "../lib/contact.ts";
import { parsePrice } from "../lib/price.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const [items, settings] = await Promise.all([getProducts(lang), getSiteSettings()]);

const productsJsonLd = items.length
  ? {
      "@context": "https://schema.org",
      "@type": "ItemList",
      itemListElement: items.map((product, index) => {
        const price = parsePrice(product.price);
        return {
          "@type": "ListItem",
          position: index + 1,
          item: {
            "@type": "Product",
            name: product.title,
            description: product.excerpt,
            image: product.image,
            ...(price && {
              offers: {
                "@type": "Offer",
                price: price.value,
                priceCurrency: price.currency,
                availability: "https://schema.org/InStock",
              },
            }),
          },
        };
      }),
    }
  : undefined;
---

<Layout
  lang={lang}
  title={getPageTitle(settings, "products", lang)}
  description={t.products.description}
  settings={settings}
  structuredData={productsJsonLd}
  alternates={pageAlternates("products")}
>
  <section class="mx-auto max-w-6xl px-5 pb-24 pt-32 md:px-8">
    <h1 class="font-serif text-5xl md:text-6xl">{t.products.title}</h1>
    {
      items.some((item) => item.language && item.language !== lang) && (
        <p class="mt-4 text-sm text-charcoal/70 dark:text-soft/70">{t.untranslated}</p>
      )
    }
    <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,1fr)_19rem] lg:items-start">
      {
        items.length ? (
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6">
            {items.map((product) => (
              <ProductCard product={product} lang={lang} />
            ))}
          </div>
        ) : (
          <p class="text-charcoal/70 dark:text-soft/70">{t.products.empty}</p>
        )
      }
      <aside class="rounded-2xl border border-charcoal/10 p-6 lg:sticky lg:top-28 dark:border-white/10">
        <HowToBuy lang={lang} settings={settings} />
      </aside>
    </div>
  </section>
</Layout>
