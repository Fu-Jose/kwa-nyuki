---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { ArrowLeft, ArrowRight } from "@lucide/astro";
import { siteName, type Lang } from "../i18n/ui";
import { isLang, pagePath, useTranslations } from "../i18n/utils";
import { getNews, getNewsBySlug, getSiteSettings } from "../lib/sanity.ts";

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = useTranslations(lang);
const [item, settings, list] = await Promise.all([getNewsBySlug(lang, slug), getSiteSettings(), getNews(lang)]);
// The router only creates article pages for published slugs, so this is not expected.
if (!item) throw new Error(`News article not found: ${lang}/${slug}`);
// hreflang + language switcher: only real, published translations. Languages without one
// fall back to that language's news list (untranslatedPage) instead of a 404.
const alternates: Partial<Record<Lang, string>> = { [lang]: Astro.url.pathname };
for (const translation of item.translations ?? []) {
  if (translation?.slug && isLang(translation.language)) {
    alternates[translation.language] = pagePath(translation.language, "news", translation.slug);
  }
}

// "Next article": the one after this in the news list (newest first, so the next older one).
const index = list.findIndex((entry) => entry.slug === slug && (entry.language ?? lang) === lang);
const next = index >= 0 ? list[index + 1] : undefined;
const nextHref = next && pagePath(isLang(next.language) ? next.language : lang, "news", next.slug);

const date = new Date(item.publishedAt).toLocaleDateString(lang, {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const organization = {
  "@type": "Organization",
  name: siteName,
  logo: { "@type": "ImageObject", url: new URL("/icon-512.png", Astro.site).toString() },
};
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: item.title,
  description: item.excerpt,
  image: item.image,
  datePublished: item.publishedAt,
  ...(item._updatedAt && { dateModified: item._updatedAt }),
  inLanguage: lang,
  author: organization,
  publisher: organization,
};

const linkClass =
  "inline-flex min-h-11 items-center gap-2 text-sm underline decoration-charcoal/30 underline-offset-4 transition-colors hover:decoration-current dark:decoration-soft/30";
---

<Layout
  lang={lang}
  title={`${item.title} · ${siteName}`}
  description={item.excerpt}
  image={item.image}
  imageAlt={item.imageAlt}
  publishedTime={item.publishedAt}
  modifiedTime={item._updatedAt}
  type="article"
  settings={settings}
  structuredData={articleJsonLd}
  alternates={alternates}
  untranslatedPage="news"
>
  <article class="mx-auto max-w-3xl px-5 pb-16 pt-32 md:px-8">
    <h1 class="font-serif text-4xl leading-tight md:text-6xl">{item.title}</h1>
    <p class="mt-4 text-sm text-sage"><time datetime={item.publishedAt}>{date}</time></p>
    <div class="mt-10 overflow-hidden rounded-3xl">
      <Image
        src={item.image}
        alt={item.imageAlt}
        width={1200}
        height={800}
        widths={[600, 1000, 1400]}
        sizes="(min-width: 768px) 704px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="w-full object-cover"
      />
    </div>
    <!-- pre-line keeps the line breaks and blank lines typed in the Studio's plain-text field -->
    <p class="mt-10 whitespace-pre-line text-lg leading-9 text-charcoal/80 dark:text-soft/80">{item.body}</p>
  </article>

  <nav
    aria-label={t.article.back}
    class="mx-auto flex max-w-3xl flex-wrap items-start justify-between gap-x-8 gap-y-4 border-t border-charcoal/10 px-5 pb-24 pt-8 md:px-8 dark:border-white/10"
  >
    <a href={pagePath(lang, "news")} class={linkClass} data-astro-prefetch>
      <ArrowLeft class="size-4" aria-hidden="true" />
      {t.article.back}
    </a>
    {
      next && nextHref && (
        <a href={nextHref} class:list={[linkClass, "max-w-xs text-right"]} data-astro-prefetch>
          <span>
            <span class="block text-xs uppercase tracking-[0.2em] text-sage no-underline">{t.article.next}</span>
            <span lang={next.language} class="font-serif text-lg">{next.title}</span>
          </span>
          <ArrowRight class="size-4 shrink-0" aria-hidden="true" />
        </a>
      )
    }
  </nav>
</Layout>
