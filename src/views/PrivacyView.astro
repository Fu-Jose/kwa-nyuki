---
import Layout from "../layouts/Layout.astro";
import type { Lang } from "../i18n/ui";
import { pageAlternates } from "../i18n/utils";
import { getPrivacyText, privacyUpdated } from "../i18n/privacy.ts";
import { getSiteSettings } from "../lib/sanity.ts";
import { getBusinessDetails, getContactDetails, getPageTitle } from "../lib/contact.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const settings = await getSiteSettings();
const { legalName, vatNumber } = getBusinessDetails(settings);
const { address, email } = getContactDetails(settings, lang);
const videoHost = (() => {
  try {
    const host = new URL(settings.heroVideoUrl).hostname;
    return host.endsWith("sanity.io") ? null : host.replace(/^(www|videos)\./, "");
  } catch {
    return null;
  }
})();

const privacy = getPrivacyText(lang, { name: legalName, address, email, vatNumber, externalVideoHost: videoHost });
const updated = new Date(privacyUpdated).toLocaleDateString(lang, { year: "numeric", month: "long", day: "numeric" });
---

<Layout
  lang={lang}
  title={getPageTitle(settings, "privacy", lang)}
  description={privacy.title}
  settings={settings}
  alternates={pageAlternates("privacy")}
>
  <article class="mx-auto max-w-3xl px-5 pb-24 pt-32 md:px-8">
    <h1 class="font-serif text-4xl leading-tight md:text-5xl">{privacy.title}</h1>
    <p class="mt-4 text-sm text-sage">
      {privacy.updated}: <time datetime={privacyUpdated}>{updated}</time>
    </p>
    {
      privacy.sections.map((section) => (
        <section class="mt-10">
          <h2 class="font-serif text-2xl">{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p class="mt-4 leading-8 text-charcoal/80 dark:text-soft/80">{paragraph}</p>
          ))}
        </section>
      ))
    }
  </article>
</Layout>
