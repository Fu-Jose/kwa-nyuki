---
import Layout from "../../layouts/Layout.astro";
import HeroVideo from "../../components/HeroVideo.astro";
import Preloader from "../../components/Preloader.astro";
import ProductCard from "../../components/ProductCard.astro";
import HowToBuy from "../../components/HowToBuy.astro";
import { Image } from "astro:assets";
import { locales, type Lang } from "../../i18n/ui";
import { isLang, localizedPath, useTranslations } from "../../i18n/utils";
import { getHomePage, getProducts, getSiteSettings } from "../../lib/sanity.ts";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang: rawLang } = Astro.params;
if (!isLang(rawLang)) return Astro.redirect("/it/");
const lang = rawLang as Lang;
const t = useTranslations(lang);
const [settings, home, products] = await Promise.all([getSiteSettings(), getHomePage(lang), getProducts(lang)]);

// Texts and photo come from the "Pagina Home" document in Sanity; each empty field keeps the built-in copy.
const hero = {
  title: home.heroTitle?.trim() || t.hero.title,
  subtitle: home.heroSubtitle?.trim() || t.hero.subtitle,
  button: home.heroButton?.trim() || t.hero.cta,
};
const story = {
  title: home.storyTitle?.trim() || t.story.title,
  text: home.storyText?.trim() || t.story.body,
  // Stock photo until the client uploads their own.
  image:
    home.storyImage ||
    "https://images.unsplash.com/photo-1473973266408-ed4e27abdd47?auto=format&fit=crop&q=80&w=1200",
  imageAlt: home.storyImage ? (home.storyImageAlt ?? "") : t.story.imageAlt,
};
const featured = products.slice(0, 3);
---

<Layout lang={lang} title={hero.title} description={hero.subtitle} transparentNav settings={settings}>
  <Preloader slot="overlay" logo={settings.logo} logoAlt={settings.logoAlt} />
  <HeroVideo
    src={settings.heroVideoUrl}
    poster={settings.heroPoster}
    title={hero.title}
    subtitle={hero.subtitle}
    ctaLabel={hero.button}
    ctaHref={localizedPath(lang, "/products/")}
  />

  <section id="story" class="mx-auto grid max-w-6xl gap-12 px-5 py-24 md:grid-cols-2 md:items-center md:px-8 md:py-32">
    <div class="reveal-on-scroll overflow-hidden rounded-3xl">
      <Image
        src={story.image}
        alt={story.imageAlt}
        width={1200}
        height={900}
        class="aspect-[4/3] h-full w-full object-cover"
      />
    </div>
    <div class="reveal-on-scroll" style="animation-delay: 120ms">
      <h2 class="font-serif text-4xl text-balance md:text-5xl">{story.title}</h2>
      <p class="mt-6 max-w-md whitespace-pre-line text-base leading-8 text-charcoal/75 dark:text-soft/75">
        {story.text}
      </p>
      <a
        href={localizedPath(lang, "/news/")}
        class="mt-6 inline-flex min-h-11 items-center text-sm underline decoration-charcoal/30 underline-offset-4 transition-colors hover:decoration-current dark:decoration-soft/30"
        data-astro-prefetch
      >
        {t.story.link}
      </a>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section aria-labelledby="home-products" class="mx-auto max-w-6xl px-5 pb-24 md:px-8 md:pb-32">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <h2 id="home-products" class="font-serif text-4xl md:text-5xl">
            {t.products.homeTitle}
          </h2>
          <a
            href={localizedPath(lang, "/products/")}
            class="inline-flex min-h-11 items-center text-sm underline decoration-charcoal/30 underline-offset-4 transition-colors hover:decoration-current dark:decoration-soft/30"
            data-astro-prefetch
          >
            {t.products.homeLink}
          </a>
        </div>
        <div class:list={["mt-10 grid gap-8", featured.length > 1 ? "sm:grid-cols-2 lg:grid-cols-3" : "max-w-3xl"]}>
          {featured.map((product) => (
            <ProductCard product={product} wide={featured.length === 1} headingLevel={3} />
          ))}
        </div>
      </section>
    )
  }

  <div class="border-t border-charcoal/10 py-24 md:py-32 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <HowToBuy lang={lang} settings={settings} wide />
    </div>
  </div>
</Layout>

<script>
  import { animate, inView } from "motion";

  function bindStory() {
    document.querySelectorAll<HTMLElement>(".reveal-on-scroll").forEach((el) => {
      inView(el, () => {
        animate(el, { opacity: [0, 1], y: [40, 0] }, { duration: 0.8, easing: [0.22, 1, 0.36, 1] });
      });
    });
  }

  bindStory();
  document.addEventListener("astro:after-swap", bindStory);
</script>
