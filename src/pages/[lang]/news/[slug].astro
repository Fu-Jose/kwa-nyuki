---
import Layout from "../../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { locales, type Lang } from "../../../i18n/ui";
import { isLang, localizedPath, useTranslations } from "../../../i18n/utils";
import { getNews, getNewsBySlug, getSiteSettings } from "../../../lib/sanity.ts";

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales) {
    const items = await getNews(lang);
    // Italian items standing in for a missing translation link to their Italian page; no duplicate here.
    for (const item of items.filter((entry) => (entry.language ?? lang) === lang)) {
      paths.push({ params: { lang, slug: item.slug } });
    }
  }
  return paths;
}

const { lang: rawLang, slug } = Astro.params;
if (!isLang(rawLang) || !slug) return Astro.redirect("/it/news/");
const lang = rawLang as Lang;
const t = useTranslations(lang);
const [item, settings] = await Promise.all([getNewsBySlug(lang, slug), getSiteSettings()]);
if (!item) return Astro.redirect(localizedPath(lang, "/news/"));
// hreflang + language switcher: only real, published translations. Languages without one
// fall back to that language's news list (untranslatedPath) instead of a 404.
const alternates: Partial<Record<Lang, string>> = { [lang]: Astro.url.pathname };
for (const translation of item.translations ?? []) {
  if (translation?.slug && isLang(translation.language)) {
    alternates[translation.language] = localizedPath(translation.language, `/news/${translation.slug}/`);
  }
}

const date = new Date(item.publishedAt).toLocaleDateString(lang, {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: item.title,
  description: item.excerpt,
  image: item.image,
  datePublished: item.publishedAt,
  inLanguage: lang,
  author: { "@type": "Organization", name: t.brand },
  publisher: { "@type": "Organization", name: t.brand },
};
---

<Layout
  lang={lang}
  title={item.title}
  description={item.excerpt}
  image={item.image}
  type="article"
  settings={settings}
  structuredData={articleJsonLd}
  alternates={alternates}
  untranslatedPath="/news/"
>
  <article class="mx-auto max-w-3xl px-5 pb-24 pt-32 md:px-8">
    <h1 class="font-serif text-4xl leading-tight md:text-6xl">{item.title}</h1>
    <p class="mt-4 text-sm text-sage"><time datetime={item.publishedAt}>{date}</time></p>
    <div class="mt-10 overflow-hidden rounded-3xl">
      <Image
        src={item.image}
        alt={item.imageAlt}
        width={1200}
        height={800}
        loading="eager"
        fetchpriority="high"
        class="w-full object-cover"
      />
    </div>
    <!-- pre-line keeps the line breaks and blank lines typed in the Studio's plain-text field -->
    <p class="mt-10 whitespace-pre-line text-lg leading-9 text-charcoal/80 dark:text-soft/80">{item.body}</p>
  </article>
</Layout>
