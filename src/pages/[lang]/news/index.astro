---
import Layout from "../../../layouts/Layout.astro";
import NewsCard from "../../../components/NewsCard.astro";
import { locales, type Lang } from "../../../i18n/ui";
import { isLang, localizedPath, useTranslations } from "../../../i18n/utils";
import { getNews, getSiteSettings } from "../../../lib/sanity.ts";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang: rawLang } = Astro.params;
if (!isLang(rawLang)) return Astro.redirect("/it/news/");
const lang = rawLang as Lang;
const t = useTranslations(lang);
const [items, settings] = await Promise.all([getNews(lang), getSiteSettings()]);
const [featured, ...rest] = items;
---

<Layout lang={lang} title={t.nav.news} settings={settings}>
  <section class="mx-auto max-w-6xl px-5 pb-24 pt-32 md:px-8">
    <p class="text-xs uppercase tracking-[0.3em] text-sage">{t.news.kicker}</p>
    <h1 class="mt-4 font-serif text-5xl md:text-6xl">{t.news.title}</h1>
    {
      featured ? (
        <div class="mt-14 space-y-16">
          <NewsCard
            item={featured}
            href={localizedPath(lang, `/news/${featured.slug}/`)}
            featured
          />
          <div class="grid gap-12 md:grid-cols-2">
            {rest.map((item) => (
              <NewsCard item={item} href={localizedPath(lang, `/news/${item.slug}/`)} />
            ))}
          </div>
        </div>
      ) : (
        <p class="mt-12 text-charcoal/70 dark:text-soft/70">{t.news.empty}</p>
      )
    }
  </section>
</Layout>
