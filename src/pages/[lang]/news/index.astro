---
import Layout from "../../../layouts/Layout.astro";
import NewsCard from "../../../components/NewsCard.astro";
import { locales, type Lang } from "../../../i18n/ui";
import { isLang, localizedPath, useTranslations } from "../../../i18n/utils";
import { getNews, getSiteSettings } from "../../../lib/sanity.ts";
import type { NewsItem } from "../../../content/fallback";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang: rawLang } = Astro.params;
if (!isLang(rawLang)) return Astro.redirect("/it/news/");
const lang = rawLang as Lang;
const t = useTranslations(lang);
const [items, settings] = await Promise.all([getNews(lang), getSiteSettings()]);
const [featured, ...rest] = items;
// An Italian article standing in for a missing translation links to its own (Italian) page.
const hrefFor = (item: NewsItem) => localizedPath(isLang(item.language) ? item.language : lang, `/news/${item.slug}/`);
const hasUntranslated = items.some((item) => item.language && item.language !== lang);
---

<Layout
  lang={lang}
  title={t.nav.news}
  description={t.news.description}
  settings={settings}
>
  <section class="mx-auto max-w-6xl px-5 pb-24 pt-32 md:px-8">
    <h1 class="font-serif text-5xl md:text-6xl">{t.news.title}</h1>
    {hasUntranslated && <p class="mt-4 text-sm text-charcoal/70 dark:text-soft/70">{t.untranslated}</p>}
    {
      featured ? (
        <div class="mt-14 space-y-16">
          <NewsCard
            item={featured}
            href={hrefFor(featured)}
            lang={lang}
            featured
          />
          <div class="grid gap-12 md:grid-cols-2">
            {rest.map((item) => (
              <NewsCard item={item} href={hrefFor(item)} lang={lang} />
            ))}
          </div>
        </div>
      ) : (
        <p class="mt-12 text-charcoal/70 dark:text-soft/70">{t.news.empty}</p>
      )
    }
  </section>
</Layout>
