---
import Layout from "../../layouts/Layout.astro";
import ShopDetails from "../../components/ShopDetails.astro";
import { locales, type Lang } from "../../i18n/ui";
import { isLang, useTranslations } from "../../i18n/utils";
import { getSiteSettings } from "../../lib/sanity.ts";
import { getContactDetails } from "../../lib/contact.ts";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang: rawLang } = Astro.params;
if (!isLang(rawLang)) return Astro.redirect("/it/contact/");
const lang = rawLang as Lang;
const t = useTranslations(lang);
const settings = await getSiteSettings();
// The map follows the address (Site Settings, else ui.ts), so it moves when the client updates it.
const { address } = getContactDetails(settings, lang);
const place = encodeURIComponent(address);
---

<Layout
  lang={lang}
  title={t.nav.contact}
  description={`${t.contact.title} ${address}`}
  settings={settings}
>
  <section class="mx-auto grid max-w-6xl gap-12 px-5 pb-24 pt-32 md:grid-cols-2 md:px-8">
    <div>
      <h1 class="font-serif text-5xl md:text-6xl">{t.contact.title}</h1>
      <ShopDetails lang={lang} settings={settings} className="mt-10" />
    </div>
    <div class="flex flex-col gap-3">
      <div class="min-h-[420px] flex-1 overflow-hidden rounded-3xl border border-charcoal/10 dark:border-white/10">
        <iframe
          class="h-full min-h-[420px] w-full"
          title={t.contact.mapTitle}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src={`https://maps.google.com/maps?q=${place}&z=14&output=embed`}
        ></iframe>
      </div>
      <a
        class="inline-flex min-h-11 items-center self-start text-sm underline decoration-charcoal/30 underline-offset-4 hover:decoration-current dark:decoration-soft/30"
        href={`https://www.google.com/maps/search/?api=1&query=${place}`}
        target="_blank"
        rel="noopener"
      >
        {t.contact.openMap}
      </a>
    </div>
  </section>
</Layout>
