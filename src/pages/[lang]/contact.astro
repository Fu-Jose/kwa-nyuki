---
import Layout from "../../layouts/Layout.astro";
import { locales, type Lang } from "../../i18n/ui";
import { isLang, useTranslations } from "../../i18n/utils";
import { getSiteSettings } from "../../lib/sanity.ts";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang: rawLang } = Astro.params;
if (!isLang(rawLang)) return Astro.redirect("/it/contact/");
const lang = rawLang as Lang;
const t = useTranslations(lang);
const settings = await getSiteSettings();
---

<Layout
  lang={lang}
  title={t.nav.contact}
  description={`${t.contact.title} ${t.contact.address}`}
  settings={settings}
>
  <section class="mx-auto grid max-w-6xl gap-12 px-5 pb-24 pt-32 md:grid-cols-2 md:px-8">
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-sage">{t.contact.kicker}</p>
      <h1 class="mt-4 font-serif text-5xl md:text-6xl">{t.contact.title}</h1>
      <dl class="mt-10 space-y-6 text-sm leading-7">
        <div>
          <dt class="uppercase tracking-[0.2em] text-sage">{t.contact.addressLabel}</dt>
          <dd class="mt-1">{t.contact.address}</dd>
        </div>
        <div>
          <dt class="uppercase tracking-[0.2em] text-sage">{t.contact.emailLabel}</dt>
          <dd class="mt-1">
            <a class="underline-offset-4 hover:underline" href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
          </dd>
        </div>
        <div>
          <dt class="uppercase tracking-[0.2em] text-sage">{t.contact.hoursLabel}</dt>
          <dd class="mt-1">{t.contact.hours}</dd>
        </div>
      </dl>
    </div>
    <div class="overflow-hidden rounded-3xl border border-charcoal/10 dark:border-white/10">
      <iframe
        class="h-[420px] w-full min-h-[420px] md:h-full"
        title="Kwa Nyuki farm map"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        src="https://maps.google.com/maps?q=Montalcino%20Italy&z=12&output=embed"
      ></iframe>
    </div>
  </section>
</Layout>
