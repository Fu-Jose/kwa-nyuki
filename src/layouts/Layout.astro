---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { locales, defaultLang, siteName, type Lang } from "../i18n/ui";
import type { SiteSettings } from "../content/fallback";
import { pagePath, useTranslations, type PageKey } from "../i18n/utils";
import { getBusinessDetails, getContactDetails } from "../lib/contact.ts";
import { sanityImageUrl } from "../lib/sanity.ts";

interface Props {
  lang: Lang;
  /** Full document title, brand included (e.g. "Il nostro miele · Kwa Nyuki"). */
  title: string;
  description?: string;
  transparentNav?: boolean;
  settings: SiteSettings;
  /** Absolute or root-relative image used for Open Graph / Twitter cards. Defaults to the site's hero poster. */
  image?: string;
  /** Description of the share image for screen readers on social platforms. */
  imageAlt?: string;
  /** Article dates (ISO) for Open Graph, on news pages. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Open Graph type. Use "article" on blog/news detail pages. */
  type?: "website" | "article";
  /**
   * This page in each language (root-relative, e.g. "/en/news/spring-harvest/"), for hreflang and
   * the language switcher. Static pages pass pageAlternates(page); an article passes only its real,
   * published translations. Defaults to this page alone.
   */
  alternates?: Partial<Record<Lang, string>>;
  /**
   * Where the language switcher sends a language missing from `alternates` (e.g. "news" for an
   * article not translated yet), instead of a guessed URL that would 404. Defaults to the home page.
   */
  untranslatedPage?: PageKey;
  /** Set true on pages that should not be indexed (e.g. a 404). */
  noindex?: boolean;
  /** One or more JSON-LD structured data objects to embed. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Set true to omit the site Navbar/Footer chrome (e.g. a standalone error page). */
  hideChrome?: boolean;
}

const {
  lang,
  title,
  description,
  transparentNav = false,
  settings,
  image,
  imageAlt,
  publishedTime,
  modifiedTime,
  type = "website",
  alternates,
  untranslatedPage = "home",
  noindex = false,
  structuredData,
  hideChrome = false,
} = Astro.props;
const t = useTranslations(lang);

const canonicalPath = Astro.url.pathname;
const canonicalURL = new URL(canonicalPath, Astro.site);
const metaDescription = description ?? t.footer.note;
// Social previews: 1200×630 JPEG from Sanity (JPEG because some apps still mishandle WebP previews).
const ogImageIsSanity = (image ?? settings.heroPoster).startsWith("https://cdn.sanity.io/");
const ogImage = sanityImageUrl(image ?? settings.heroPoster, { w: 1200, h: 630, fit: "crop", fm: "jpg", q: 80 });
const ogLocales: Record<Lang, string> = { it: "it_IT", en: "en_GB", fr: "fr_FR" };

const alternatePaths: Partial<Record<Lang, string>> = alternates ?? { [lang]: canonicalPath };
const alternateEntries = Object.entries(alternatePaths) as [Lang, string][];
const xDefaultPath = alternatePaths[defaultLang] ?? canonicalPath;
const languageLinks = Object.fromEntries(
  locales.map((code) => [code, alternatePaths[code] ?? pagePath(code, untranslatedPage)]),
) as Record<Lang, string>;

const jsonLdBlocks = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];

// CMS text (product/news titles, excerpts...) flows into this JSON unescaped.
// Without this, a "<" the client types in Sanity — accidental or not — could
// close the <script> tag early and inject markup. Escaping every "<" is safe:
// JSON.parse still reads < back as "<".
function toJsonLd(data: Record<string, unknown>) {
  return JSON.stringify(data).replace(/</g, "\\u003c");
}

const contact = getContactDetails(settings, lang);
const business = getBusinessDetails(settings);
const localBusinessJsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: siteName,
  ...(business.legalName !== siteName && { legalName: business.legalName }),
  ...(business.vatNumber && { vatID: `IT${business.vatNumber}` }),
  description: t.footer.note,
  url: Astro.site?.toString(),
  logo: new URL("/icon-512.png", Astro.site).toString(),
  image: ogImage,
  email: contact.email,
  ...(contact.phone && { telephone: contact.phone }),
  address: {
    "@type": "PostalAddress",
    streetAddress: contact.address,
  },
  openingHours: contact.hours,
  sameAs: [settings.instagram, settings.facebook].filter(Boolean),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fcf9f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="canonical" href={canonicalURL} />
    {
      alternateEntries.map(([code, path]) => (
        <link rel="alternate" hreflang={code} href={new URL(path, Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(xDefaultPath, Astro.site)} />

    <title>{title}</title>

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {
      alternateEntries
        .filter(([code]) => code !== lang)
        .map(([code]) => <meta property="og:locale:alternate" content={ogLocales[code]} />)
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    {ogImageIsSanity && <meta property="og:image:width" content="1200" />}
    {ogImageIsSanity && <meta property="og:image:height" content="630" />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    <script type="application/ld+json" set:html={toJsonLd(localBusinessJsonLd)} />
    {jsonLdBlocks.map((data) => <script type="application/ld+json" set:html={toJsonLd(data)} />)}

    <script is:inline>
      (function () {
        const root = document.documentElement;
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        root.classList.toggle("dark", stored ? stored === "dark" : prefersDark);
        // Scroll reveals start hidden only when JS runs (see .reveal-on-scroll in global.css).
        root.classList.add("js");
        // Home preloader: once per browser session, never with reduced motion.
        try {
          if (sessionStorage.getItem("kwa-preloaded") || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            root.classList.add("skip-preloader");
          }
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="font-sans">
    <a href="#main" class="skip-link">{t.a11y.skip}</a>
    <!-- Full-screen overlays (the home preloader) live outside <main>: its view-transition-name
         creates a stacking context that would keep them under the fixed header. -->
    <slot name="overlay" />
    {!hideChrome && (
      <Navbar lang={lang} transparent={transparentNav} settings={settings} languageLinks={languageLinks} />
    )}
    <main id="main" tabindex="-1" class="outline-none" transition:animate="fade">
      <slot />
    </main>
    {!hideChrome && <Footer lang={lang} settings={settings} />}
    <script>
      const themeWindow = window as Window & { __kwaThemeBound?: boolean };

      function currentTheme(): "light" | "dark" {
        const stored = localStorage.getItem("theme");
        if (stored === "light" || stored === "dark") return stored;
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }

      function applyTheme(theme: "light" | "dark") {
        document.documentElement.classList.toggle("dark", theme === "dark");
        localStorage.setItem("theme", theme);
        document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((button) => {
          button.setAttribute(
            "aria-label",
            theme === "dark" ? button.dataset.labelLight ?? "Light mode" : button.dataset.labelDark ?? "Dark mode",
          );
        });
      }

      function syncTheme() {
        applyTheme(currentTheme());
      }

      if (!themeWindow.__kwaThemeBound) {
        themeWindow.__kwaThemeBound = true;

        document.addEventListener("click", (event) => {
          const button = (event.target as HTMLElement | null)?.closest(".theme-toggle");
          if (!button) return;
          applyTheme(document.documentElement.classList.contains("dark") ? "light" : "dark");
        });

        document.addEventListener("astro:before-swap", (event) => {
          const dark = document.documentElement.classList.contains("dark");
          event.newDocument.documentElement.classList.toggle("dark", dark);
        });

        document.addEventListener("astro:after-swap", syncTheme);
        document.addEventListener("astro:page-load", syncTheme);
      }

      syncTheme();
    </script>
  </body>
</html>
