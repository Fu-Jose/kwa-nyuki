---
import { languages, locales, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  /** Target page per language, resolved by Layout (real translation, or the section index). */
  links: Record<Lang, string>;
  className?: string;
}

const { lang, links, className = "" } = Astro.props;
---

<nav class:list={["flex items-center text-sm tracking-[0.2em]", className]} aria-label="Languages">
  {
    locales.map((code) => (
      <a
        href={links[code]}
        class:list={[
          // 44px touch target; the active language is marked by an underline, not by colour alone,
          // so it stays visible over the home video and in both themes.
          "grid min-h-11 min-w-11 place-items-center underline-offset-[6px] transition-colors",
          code === lang
            ? "text-current underline decoration-honey decoration-2"
            : "text-current/75 hover:text-current",
        ]}
        hreflang={code}
        aria-current={code === lang ? "true" : undefined}
      >
        {languages[code]}
      </a>
    ))
  }
</nav>
