---
import Logo from './Logo.astro';
import type { Lang } from '../i18n/ui';
import { pagePath, useTranslations } from '../i18n/utils';
import type { SiteSettings } from '../content/fallback';
import { getBusinessDetails } from '../lib/contact.ts';

interface Props {
  lang: Lang;
  settings: SiteSettings;
}

const { lang, settings } = Astro.props;
const t = useTranslations(lang);
const { legalName, vatNumber } = getBusinessDetails(settings);
---

<footer
  class='border-t border-charcoal/10 bg-wax px-5 py-16 dark:border-white/10 dark:bg-midnight'
>
  <div
    class='mx-auto flex max-w-6xl flex-col gap-10 md:flex-row md:items-end md:justify-between'
  >
    <div>
      <a href={pagePath(lang, 'home')}>
        <Logo src={settings.logo} alt={settings.logoAlt} />
      </a>
      <p class='mt-4 max-w-sm text-sm text-charcoal/70 dark:text-soft/70'>
        {t.footer.note}
      </p>
    </div>
    <div class='flex items-center gap-4'>
      {
        settings.instagram && (
          <a
            href={settings.instagram}
            class='rounded-full border border-current/15 p-3'
            aria-label='Instagram'
          >
            <svg
              class='size-6'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              aria-hidden='true'
            >
              <rect x='3' y='3' width='18' height='18' rx='5' />
              <circle cx='12' cy='12' r='4' />
              <circle cx='17.5' cy='6.5' r='0.8' fill='currentColor' />
            </svg>
          </a>
        )
      }
      {
        settings.facebook && (
          <a
            href={settings.facebook}
            class='rounded-full border border-current/15 p-3'
            aria-label='Facebook'
          >
            <svg
              class='size-6'
              viewBox='0 0 24 24'
              fill='currentColor'
              aria-hidden='true'
            >
              <path d='M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z' />
            </svg>
          </a>
        )
      }
    </div>
  </div>
  <div
    class='mx-auto mt-12 flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-1 text-xs tracking-wide text-charcoal/70 dark:text-soft/60'
  >
    <p>
      © {new Date().getFullYear()} {legalName}. {t.footer.rights}
      {vatNumber && <span class='whitespace-nowrap'>{t.legal.vat} {vatNumber}</span>}
    </p>
    <a
      href={pagePath(lang, 'privacy')}
      class='inline-flex min-h-11 items-center underline decoration-current/30 underline-offset-4 hover:decoration-current'
    >
      {t.legal.privacy}
    </a>
  </div>
</footer>
