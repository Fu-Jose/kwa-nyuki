---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import type { Lang } from "../i18n/ui";
import { getNavLinks, useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
  languageLinks: Record<Lang, string>;
}

const { lang, languageLinks } = Astro.props;
const t = useTranslations(lang);
const links = getNavLinks(lang);
const path = Astro.url.pathname;
const isCurrent = (link: (typeof links)[number]) =>
  link.page === "home" ? path === link.href : path.startsWith(link.href);
---

<div
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden"
  data-open="false"
>
  <div class="absolute inset-0 bg-wax/80 backdrop-blur-2xl dark:bg-midnight/85"></div>
  <div class="relative flex h-full flex-col px-8 pb-10 pt-28">
    <nav class="flex flex-1 flex-col justify-center gap-2" aria-label={t.a11y.navMobile}>
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link) ? "page" : undefined}
            class="menu-item w-fit font-serif text-5xl leading-tight text-charcoal decoration-honey decoration-2 underline-offset-8 aria-[current=page]:underline dark:text-soft sm:text-6xl"
            data-astro-prefetch
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <LanguageSwitcher lang={lang} links={languageLinks} className="justify-center pb-[env(safe-area-inset-bottom)]" />
  </div>
</div>

<style>
  #mobile-menu[data-open="true"] {
    display: block;
  }

  #mobile-menu[data-open="true"] .menu-item {
    animation: menu-rise 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* Staggered entrance (set here rather than in a style attribute, which the CSP would block). */
  #mobile-menu[data-open="true"] .menu-item:nth-child(2) { animation-delay: 70ms; }
  #mobile-menu[data-open="true"] .menu-item:nth-child(3) { animation-delay: 140ms; }
  #mobile-menu[data-open="true"] .menu-item:nth-child(4) { animation-delay: 210ms; }
</style>
