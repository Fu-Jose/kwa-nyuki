---
import { Image } from "astro:assets";
import type { NewsItem } from "../content/fallback";
import type { Lang } from "../i18n/ui";

interface Props {
  item: NewsItem;
  href: string;
  lang: Lang;
  featured?: boolean;
}

const { item, href, lang, featured = false } = Astro.props;
const date = new Date(item.publishedAt).toLocaleDateString(lang, {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a href={href} class:list={["group block", featured && "md:col-span-2"]} data-astro-prefetch>
  <article class:list={["grid gap-6", featured && "md:grid-cols-2 md:gap-10"]}>
    <div class:list={["overflow-hidden rounded-2xl", featured ? "aspect-[16/10]" : "aspect-[16/11]"]}>
      <Image
        src={item.image}
        alt={item.imageAlt}
        width={featured ? 1200 : 800}
        height={featured ? 750 : 550}
        loading={featured ? "eager" : "lazy"}
        fetchpriority={featured ? "high" : "auto"}
        class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
      />
    </div>
    <div class="flex flex-col justify-center">
      <h2 class:list={["font-serif leading-tight", featured ? "text-4xl md:text-5xl" : "text-2xl"]}>
        {item.title}
      </h2>
      <p class="mt-2 text-sm text-sage"><time datetime={item.publishedAt}>{date}</time></p>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-charcoal/70 dark:text-soft/70">{item.excerpt}</p>
    </div>
  </article>
</a>
