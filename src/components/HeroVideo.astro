---
interface Props {
  src: string;
  poster: string;
  kicker: string;
  title: string;
  subtitle: string;
  ctaLabel: string;
  ctaHref: string;
}

const { src, poster, kicker, title, subtitle, ctaLabel, ctaHref } = Astro.props;
---

<section class="relative h-dvh min-h-[640px] overflow-hidden bg-charcoal">
  <video
    id="hero-video"
    class="absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={poster}
  >
    <source src={src} type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-black/25"></div>
  <div class="relative z-10 flex h-full flex-col justify-end px-5 pb-16 md:px-12 md:pb-24">
    <p class="mb-4 text-xs uppercase tracking-[0.35em] text-white/80">{kicker}</p>
    <h1 class="max-w-3xl font-serif text-5xl leading-[1.05] text-white md:text-7xl">{title}</h1>
    <p class="mt-5 max-w-xl text-base text-white/80 md:text-lg">{subtitle}</p>
    <a
      href={ctaHref}
      class="mt-8 inline-flex w-fit items-center border border-white/40 px-6 py-3 text-xs uppercase tracking-[0.25em] text-white transition hover:bg-white hover:text-charcoal"
    >
      {ctaLabel}
    </a>
  </div>
</section>
