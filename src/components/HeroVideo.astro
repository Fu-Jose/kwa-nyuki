---
import { Pause, Play } from "@lucide/astro";

interface Props {
  src: string;
  poster: string;
  title: string;
  subtitle: string;
  ctaLabel: string;
  ctaHref: string;
  pauseLabel: string;
  playLabel: string;
}

const { src, poster, title, subtitle, ctaLabel, ctaHref, pauseLabel, playLabel } = Astro.props;
---

<!-- Fills the viewport (svh, so it never sits under phone browser bars); on short landscape screens
     the min-height yields to the viewport and the text tightens (short: variant, see global.css). -->
<section class="relative h-svh min-h-[min(640px,100svh)] overflow-hidden bg-charcoal">
  <!-- No autoplay attribute: the script starts it, unless the visitor asked the system for reduced
       motion. preload="metadata" fetches only the header; the file streams once playback starts. -->
  <video
    id="hero-video"
    class="absolute inset-0 h-full w-full object-cover"
    muted
    loop
    playsinline
    preload="metadata"
    poster={poster}
    aria-hidden="true"
  >
    <source src={src} type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-black/25"></div>
  <div class="relative z-10 flex h-full flex-col justify-end px-5 pb-16 md:px-12 md:pb-24 short:pb-8">
    <h1 class="max-w-3xl font-serif text-5xl leading-[1.05] text-white md:text-7xl short:text-4xl">{title}</h1>
    <p class="mt-5 max-w-xl text-base text-white/80 md:text-lg short:mt-3">{subtitle}</p>
    <a
      href={ctaHref}
      class="mt-8 inline-flex w-fit items-center border border-white/40 px-6 py-3 text-xs uppercase tracking-[0.25em] text-white transition hover:bg-white hover:text-charcoal short:mt-5"
    >
      {ctaLabel}
    </a>
  </div>
  <button
    type="button"
    id="hero-video-toggle"
    class="absolute bottom-5 right-5 z-20 grid size-11 place-items-center rounded-full bg-black/30 text-white/90 backdrop-blur-sm transition-colors hover:bg-black/50 md:bottom-8 md:right-8"
    aria-label={playLabel}
    data-label-pause={pauseLabel}
    data-label-play={playLabel}
    data-state="paused"
  >
    <Pause class="icon-pause size-4" aria-hidden="true" />
    <Play class="icon-play size-4" aria-hidden="true" />
  </button>
</section>

<style>
  #hero-video-toggle[data-state="paused"] .icon-pause,
  #hero-video-toggle[data-state="playing"] .icon-play {
    display: none;
  }
</style>

<script>
  function bindHeroVideo() {
    const video = document.getElementById("hero-video") as HTMLVideoElement | null;
    const button = document.getElementById("hero-video-toggle") as HTMLButtonElement | null;
    if (!video || !button) return;

    const sync = () => {
      const paused = video.paused;
      button.dataset.state = paused ? "paused" : "playing";
      button.setAttribute("aria-label", (paused ? button.dataset.labelPlay : button.dataset.labelPause) ?? "");
    };
    video.onplay = sync;
    video.onpause = sync;
    button.onclick = () => (video.paused ? video.play().catch(() => {}) : video.pause());

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) video.play().catch(() => {});
    sync();
  }

  bindHeroVideo();
  document.addEventListener("astro:page-load", bindHeroVideo);
</script>
