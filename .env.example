# Used by the Astro site (src/lib/sanity.ts) — Astro/Vite's own convention
# for exposing an env var to app code.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Used by Sanity Studio itself (sanity.config.ts, sanity.cli.ts) — Sanity's
# tooling only picks up its own SANITY_STUDIO_ prefix, not Astro's PUBLIC_.
# Same project/dataset, just set twice for the two separate build tools.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
